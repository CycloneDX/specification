{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "http://example.com/test/main-bundled.schema.json",
  "$comment": "Root schema. This $comment is the only one that survives minification.",
  "title": "Main",
  "type": "object",
  "properties": {
    "whole": {
      "$comment": "External ref without fragment -> module is kept as a whole.",
      "$ref": "#/$defs/used-whole"
    },
    "sub": {
      "$comment": "External ref into a sub-def -> only that sub-def (and what it reaches) is kept.",
      "$ref": "#/$defs/used-subdefs-only/$defs/kept"
    },
    "local": {
      "$comment": "Internal ref -> rewritten to #/$defs/main/$defs/mainLocal, so the root's own def entry must be emitted.",
      "$ref": "#/$defs/main/$defs/mainLocal"
    }
  },
  "$defs": {
    "dynamic-anchor": {
      "$dynamicAnchor": "node",
      "title": "Dynamic anchor",
      "type": "object",
      "properties": {
        "children": {
          "type": "array",
          "items": {
            "$comment": "Self-ref '#' -> rewritten to #/$defs/dynamic-anchor.",
            "$ref": "#/$defs/dynamic-anchor"
          }
        }
      }
    },
    "spdx": {
      "$defs": {
        "licenseId": {
          "type": "string",
          "enum": [
            "Apache-2.0",
            "MIT"
          ]
        }
      }
    },
    "unused": {
      "title": "Unused",
      "type": "object",
      "properties": {
        "pullsNothingIn": {
          "$comment": "Even though this refs a module, it is itself unreachable and must not influence shaking.",
          "$ref": "#/$defs/used-whole/$defs/unusedButKept"
        }
      }
    },
    "used-subdefs-only": {
      "title": "Used sub-defs only",
      "type": "object",
      "properties": {
        "body": {
          "$comment": "Lives in the dropped body, so this ref must NOT make unused.schema.json reachable.",
          "$ref": "#/$defs/unused"
        }
      },
      "$defs": {
        "kept": {
          "$comment": "Reached from main. Exercises three ref flavours.",
          "type": "object",
          "properties": {
            "shared": {
              "$comment": "Cross-module ref into another module's sub-def.",
              "$ref": "#/$defs/used-whole/$defs/sharedByOther"
            },
            "fromMain": {
              "$comment": "Ref back into the root schema -> #/$defs/main/$defs/mainLocal.",
              "$ref": "#/$defs/main/$defs/mainLocal"
            },
            "chain": {
              "$comment": "Internal ref -> transitively keeps keptTransitively.",
              "$ref": "#/$defs/used-subdefs-only/$defs/keptTransitively"
            }
          }
        },
        "keptTransitively": {
          "$comment": "Only reachable via kept.chain.",
          "type": "string"
        },
        "dropped": {
          "$comment": "Not reachable -> shaken away.",
          "type": "null"
        }
      }
    },
    "used-whole": {
      "title": "Used whole",
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "inner": {
          "$comment": "Internal ref -> rewritten to #/$defs/used-whole/$defs/inner.",
          "$ref": "#/$defs/used-whole/$defs/inner"
        },
        "license": {
          "$comment": "spdx.schema.json is in the ref-exception list -> rewired to a path relative to the root schema, not bundled.",
          "$ref": "modules/spdx.schema.json#/$defs/licenseId"
        }
      },
      "$defs": {
        "inner": {
          "type": "integer"
        },
        "unusedButKept": {
          "$comment": "Not referenced anywhere, but kept because the module is used as a whole.",
          "type": "boolean"
        },
        "sharedByOther": {
          "$comment": "Cross-referenced from used-subdefs-only#/$defs/kept.",
          "type": "number"
        }
      }
    },
    "main": {
      "title": "Main",
      "type": "object",
      "properties": {
        "whole": {
          "$comment": "External ref without fragment -> module is kept as a whole.",
          "$ref": "#/$defs/used-whole"
        },
        "sub": {
          "$comment": "External ref into a sub-def -> only that sub-def (and what it reaches) is kept.",
          "$ref": "#/$defs/used-subdefs-only/$defs/kept"
        },
        "local": {
          "$comment": "Internal ref -> rewritten to #/$defs/main/$defs/mainLocal, so the root's own def entry must be emitted.",
          "$ref": "#/$defs/main/$defs/mainLocal"
        }
      },
      "$defs": {
        "mainLocal": {
          "$comment": "Referenced from main itself and from used-subdefs-only.",
          "type": "string"
        },
        "mainUnused": {
          "$comment": "Never referenced -> shaken away from #/$defs/main/$defs.",
          "type": "null"
        }
      }
    }
  }
}