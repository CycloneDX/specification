@startuml CycloneDX AI/ML Schema 2.0

!define ENTITY class
!define ENUM enum

title CycloneDX AI/ML Schema 2.0 - UML Class Diagram

' Main Model Card
ENTITY ModelCard {
  + architecture : ModelArchitecture
  + designConsiderations : DesignConsiderations
  + trainingProfile : TrainingProfile
}

' Model Architecture
ENTITY ModelArchitecture {
  + structural : Structural
  + behavioralParadigm : string[]
  + specializedProcessing : string[]
  + externalReferences : ExternalReference[]
  + properties : Property[]
}

ENTITY Structural {
  + primary : string {required}
  + topologyType : string
  + secondary : string[]
}

note right of Structural
  Examples:
  - primary: "Transformer", "CNN", "RNN", "Mamba"
  - topologyType: "Dense", "Sparse", "Dynamic", "Liquid"
  - secondary: ["Decoder-Only", "Mixture-of-Experts"]
end note

' Design Considerations
ENTITY DesignConsiderations {
  + users : Actor[]
  + useCases : UseCases
  + technicalLimitations : Consideration[]
  + performanceTradeoffs : Consideration[]
  + ethicalConsiderations : Consideration[]
  + environmentalConsiderations : EnvironmentalConsiderations
  + fairnessAssessments : Consideration[]
  + externalReferences : ExternalReference[]
  + properties : Property[]
}

' Consideration
ENTITY Consideration {
  + name : string {required}
  + description : string
  + groupsAtRisk : RiskGroup[]
  + externalReferences : ExternalReference[]
  + properties : Property[]
}

' Risk Group
ENTITY RiskGroup {
  + groupName : string {required}
  + groupDescription : string
  + type : string
  + description : string
  + priority : string
  + externalReferences : ExternalReference[]
  + properties : Property[]
}

note right of RiskGroup
  Extends riskDomain from
  cyclonedx-risk-2.0.schema.json
end note

' Training Profile
ENTITY TrainingProfile {
  + dataProcessingSpec : DatasetProcessingSpec[]
  + trainingDatasets : DatasetProcessingSpec[]
  + trainingFormula : TrainingFormula
}

ENTITY DatasetProcessingSpec {
  + datasets : DatasetReference[]
  + datasetProcessingFormula : string
  + externalReferences : ExternalReference[]
  + properties : Property[]
}

ENTITY DatasetReference {
  + dataRef : string
}

note right of DatasetReference
  References a data component
  by bom-ref attribute or
  BOM-Link reference
end note

ENTITY TrainingFormula {
  + formulaRef : string
}

note right of TrainingFormula
  Reference to the training formula
  defined elsewhere in the BOM
end note

' Environmental Considerations
ENTITY EnvironmentalConsiderations {
  + energyConsumptions : EnergyConsumption[]
  + properties : Property[]
}

ENTITY EnergyConsumption {
  + activity : ActivityType {required}
  + energyProviders : EnergyProvider[] {required}
  + activityEnergyCost : EnergyMeasure {required}
  + co2CostEquivalent : CO2Measure
  + co2CostOffset : CO2Measure
  + properties : Property[]
}

ENUM ActivityType {
  design
  data-collection
  data-preparation
  training
  fine-tuning
  validation
  deployment
  inference
  other
}

note right of ActivityType
  ML model development or
  operational lifecycle activities
end note

ENTITY EnergyProvider {
  + bom-ref : string
  + description : string
  + organization : OrganizationalEntity {required}
  + energySource : EnergySource {required}
  + energyProvided : EnergyMeasure {required}
  + externalReferences : ExternalReference[]
}

ENUM EnergySource {
  coal
  oil
  natural-gas
  nuclear
  wind
  solar
  geothermal
  hydropower
  biofuel
  unknown
  other
}

ENTITY EnergyMeasure {
  + value : number {required}
  + unit : string {required}
}

note right of EnergyMeasure
  Unit: "kWh" (Kilowatt-hour)
end note

ENTITY CO2Measure {
  + value : number {required}
  + unit : string {required}
}

note right of CO2Measure
  Unit: "tCO2eq" (Tonnes of CO2 equivalent)
end note

' Graphic
ENTITY Graphic {
  + name : string
  + image : Attachment
}

' External References (from common schema)
ENTITY ExternalReference <<external>> {
  + url : string
  + type : string
  + comment : string
  + hashes : Hash[]
}

ENTITY Property <<external>> {
  + name : string
  + value : string
}

ENTITY OrganizationalEntity <<external>> {
  + name : string
  + url : string[]
  + contact : Contact[]
}

ENTITY Actor <<external>> {
  + (from blueprint schema)
}

ENTITY UseCases <<external>> {
  + (from usecase schema)
}

ENTITY Attachment <<external>> {
  + content : string
  + contentType : string
  + encoding : string
}

' Relationships
ModelCard "1" *-- "0..1" ModelArchitecture : contains
ModelCard "1" *-- "0..1" DesignConsiderations : contains
ModelCard "1" *-- "0..1" TrainingProfile : contains

ModelArchitecture "1" *-- "0..1" Structural : contains
ModelArchitecture "1" *-- "0..*" ExternalReference : references
ModelArchitecture "1" *-- "0..*" Property : has

DesignConsiderations "1" *-- "0..*" Actor : users
DesignConsiderations "1" *-- "0..1" UseCases : useCases
DesignConsiderations "1" *-- "0..*" Consideration : technicalLimitations
DesignConsiderations "1" *-- "0..*" Consideration : performanceTradeoffs
DesignConsiderations "1" *-- "0..*" Consideration : ethicalConsiderations
DesignConsiderations "1" *-- "0..1" EnvironmentalConsiderations : environmentalConsiderations
DesignConsiderations "1" *-- "0..*" Consideration : fairnessAssessments
DesignConsiderations "1" *-- "0..*" ExternalReference : references
DesignConsiderations "1" *-- "0..*" Property : has

Consideration "1" *-- "0..*" RiskGroup : groupsAtRisk
Consideration "1" *-- "0..*" ExternalReference : references
Consideration "1" *-- "0..*" Property : has

RiskGroup "1" *-- "0..*" ExternalReference : references
RiskGroup "1" *-- "0..*" Property : has

TrainingProfile "1" *-- "0..*" DatasetProcessingSpec : dataProcessingSpec
TrainingProfile "1" *-- "0..*" DatasetProcessingSpec : trainingDatasets
TrainingProfile "1" *-- "0..1" TrainingFormula : trainingFormula

DatasetProcessingSpec "1" *-- "0..*" DatasetReference : datasets
DatasetProcessingSpec "1" *-- "0..*" ExternalReference : references
DatasetProcessingSpec "1" *-- "0..*" Property : has

EnvironmentalConsiderations "1" *-- "0..*" EnergyConsumption : energyConsumptions
EnvironmentalConsiderations "1" *-- "0..*" Property : has

EnergyConsumption "1" *-- "1" ActivityType : activity
EnergyConsumption "1" *-- "1..*" EnergyProvider : energyProviders
EnergyConsumption "1" *-- "1" EnergyMeasure : activityEnergyCost
EnergyConsumption "1" *-- "0..1" CO2Measure : co2CostEquivalent
EnergyConsumption "1" *-- "0..1" CO2Measure : co2CostOffset
EnergyConsumption "1" *-- "0..*" Property : has

EnergyProvider "1" *-- "1" OrganizationalEntity : organization
EnergyProvider "1" *-- "1" EnergySource : energySource
EnergyProvider "1" *-- "1" EnergyMeasure : energyProvided
EnergyProvider "1" *-- "0..*" ExternalReference : references

Graphic "1" *-- "0..1" Attachment : image

@enduml