
# some schemas are generated by a tool: ../../../tools/src/main/js/bundler/bundle-schemas.js
[*{-bundled,-bundled.min}.schema.json]
indent_style = unset
indent_size = unset
tab_width = unset
end_of_line = unset
charset = unset
trim_trailing_whitespace = unset
insert_final_newline = unset
max_line_length = unset
