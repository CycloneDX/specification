{
  "$schema": "https://cyclonedx.org/schema/2.0/cyclonedx-2.0.schema.json",
  "specFormat": "CycloneDX",
  "specVersion": "2.0",
  "definitions": {
    "components": [
      {
        "type": "cryptographic-asset",
        "name": "TLS 1.3 endpoint configuration",
        "cryptoProperties": {
          "assetType": "protocol",
          "protocolProperties": {
            "type": "tls",
            "version": "1.3",
            "cipherSuites": [
              { "name": "TLS_AES_128_GCM_SHA256" },
              { "name": "TLS_AES_256_GCM_SHA384" }
            ],
            "tlsGroups": [ "x25519", "secp256r1" ],
            "tlsSignatureSchemes": [ "ecdsa_secp256r1_sha256", "rsa_pss_rsae_sha256" ]
          }
        }
      },
      {
        "type": "cryptographic-asset",
        "name": "TLS named groups including finite-field and hybrid",
        "cryptoProperties": {
          "assetType": "protocol",
          "protocolProperties": {
            "type": "tls",
            "version": "1.3",
            "tlsGroups": [ "x25519", "ffdhe2048", "X25519MLKEM768" ]
          }
        }
      },
      {
        "type": "cryptographic-asset",
        "name": "TLS groups observed without cipher suite information",
        "cryptoProperties": {
          "assetType": "protocol",
          "protocolProperties": {
            "type": "tls",
            "tlsGroups": [ "x25519" ]
          }
        }
      },
      {
        "type": "cryptographic-asset",
        "name": "TLS signature schemes observed without group information",
        "cryptoProperties": {
          "assetType": "protocol",
          "protocolProperties": {
            "type": "tls",
            "tlsSignatureSchemes": [ "ed25519" ]
          }
        }
      },
      {
        "type": "cryptographic-asset",
        "name": "TLS 1.2 protocol and cipher suite associations",
        "cryptoProperties": {
          "assetType": "protocol",
          "protocolProperties": {
            "type": "tls",
            "version": "1.2",
            "cipherSuites": [
              {
                "name": "TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256",
                "tlsGroups": [ "secp256r1" ],
                "tlsSignatureSchemes": [ "ecdsa_secp256r1_sha256" ]
              },
              {
                "name": "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256",
                "tlsGroups": [ "x25519" ],
                "tlsSignatureSchemes": [ "rsa_pkcs1_sha256" ]
              }
            ],
            "tlsGroups": [ "x25519", "secp256r1" ],
            "tlsSignatureSchemes": [ "ecdsa_secp256r1_sha256", "rsa_pkcs1_sha256" ]
          }
        }
      }
    ]
  }
}
