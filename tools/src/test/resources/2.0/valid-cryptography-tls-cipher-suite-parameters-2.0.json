{
  "$schema": "https://cyclonedx.org/schema/2.0/cyclonedx-2.0.schema.json",
  "specFormat": "CycloneDX",
  "specVersion": "2.0",
  "definitions": {
    "components": [
      {
        "type": "cryptographic-asset",
        "name": "TLS cipher suite associations",
        "cryptoProperties": {
          "assetType": "protocol",
          "protocolProperties": {
            "type": "tls",
            "version": "1.2",
            "cipherSuites": [
              {
                "name": "TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256",
                "tlsGroups": [ "x25519" ],
                "tlsSignatureSchemes": [ "rsa_pkcs1_sha256" ]
              }
            ]
          }
        }
      },
      {
        "type": "cryptographic-asset",
        "name": "TLS 1.3 cipher suite without groups or signature schemes",
        "cryptoProperties": {
          "assetType": "protocol",
          "protocolProperties": {
            "type": "tls",
            "version": "1.3",
            "cipherSuites": [
              { "name": "TLS_AES_128_GCM_SHA256" }
            ]
          }
        }
      }
    ]
  }
}
