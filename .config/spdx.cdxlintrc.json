{
  "checks": {
    "schema-id-filepath": {
      "pattern": "^http://cyclonedx\\.org(/schema/.+\\.schema\\.json)$"
    },
    "schema-id-pattern": {
      "pattern": "^http://cyclonedx\\.org/schema/.*\\.schema\\.json$"
    },
    "schema-draft": {
      "requiredSchema": "http://json-schema.org/draft-07/schema#"
    }
  },
  "excludeChecks": [
    "enum-value-formatting",
    "meta-enum-full-stop",
    "description-oxford-english",
    "property-name-american-english",
    "schema-comment"
  ]
}
